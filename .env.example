# ====================================================================
# ClipForge AI - Configurações de Ambiente para Produção
# ====================================================================

# Portas dos Serviços
PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Banco de Dados PostgreSQL
DATABASE_URL=host=db user=postgres password=postgres dbname=clipforge port=5432 sslmode=disable

# Redis (Mensageria e Filas)
REDIS_URL=redis://redis:6379/0

# ====================================================================
# Chaves de Inteligência Artificial em Nuvem (Ultra Rápidas)
# ====================================================================
# Groq (Recomendado para Transcrição Whisper ultra-rápida em ~3 segundos)
GROQ_API_KEY=gsk_...

# Google Gemini (Recomendado para Análise Viral Single-Shot com Gemini 2.0 Flash)
GEMINI_API_KEY=AIzaSy...

# OpenAI (Opcional - Whisper-1 e GPT-4o-mini)
OPENAI_API_KEY=sk-proj-...

# ====================================================================
# Configurações de Renderização e Armazenamento
# ====================================================================
UPLOAD_DIR=/app/uploads
CLIPS_DIR=/app/uploads/clips
MAX_CONCURRENT_RENDERS=2
